# See http://help.github.com/ignore-files/ for more about ignoring files.

# General
*.log
*.DS_Store

# Ignore IDE files
.idea/
.vscode/
.agent/
.venv/

# Backend specific
timetable-app-backend/target/
timetable-app-backend/local/

# Frontend specific
timetable-app/node_modules/
timetable-app/dist/
timetable-app/.angular/

# ── Docker / Secrets ──────────────────────────────────────────────────────────
# .env.dev is committed (safe development defaults)
# .env.prod.example is committed (template, no real secrets)
# .env.prod must NEVER be committed
.env.prod

# Docker runtime secrets directory (files written here should not be tracked)
docker/secrets/

# Docker build cache artefacts
.dockerignore.local

# ── Secrets & Licenses ────────────────────────────────────────────────────────
*.pem
/secrets/
.env*.local
.env.local

