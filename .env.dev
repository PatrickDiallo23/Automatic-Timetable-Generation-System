# ─────────────────────────────────────────────────────────────────────────────
# .env.dev  —  Development environment variables
#
# ⚠️  This file is committed to version control because it contains only
#     non-sensitive development defaults. Never commit .env.prod.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=timetable_dev
POSTGRES_USER=timetable_user
POSTGRES_PASSWORD=timetable_dev_password
POSTGRES_PORT=5432

# ── Spring Boot ───────────────────────────────────────────────────────────────
# Note that you can change the database url if you have multiple databases (or work with volumes)
DATABASE_URL=jdbc:postgresql://postgres:5432/timetable_dev
DATABASE_USERNAME=timetable_user
DATABASE_PASSWORD=timetable_dev_password
JWT_SECRET_KEY=gkWG5DPcdokzcLgkNHgBQq8ftprrZd/SJvjsyhwAUEM=
SPRING_PROFILES_ACTIVE=dev

# ── Java / Timefold ───────────────────────────────────────────────────────────
# Dev uses lighter resource limits; solver terminates early
JAVA_OPTS=-Xms256m
TIMEFOLD_TERMINATION_LIMIT=6m

# ── Timefold Solver License ───────────────────────────────────────────────────
# For container run: Place your license file in `./secrets/timefold-license.pem`
# OR set the PEM string content below:
TIMEFOLD_LICENSE=
TIMEFOLD_LICENSE_PATH=./secrets/timefold-license.pem

# ── Ports exposed to host ─────────────────────────────────────────────────────
# Nginx load balancer → http://localhost:4200
NGINX_PORT=4200
BACKEND_DEBUG_PORT=5005 # Remote JVM debug port (dev only)
PG_EXPOSED_PORT=5433   # Direct Postgres access (dev only)

