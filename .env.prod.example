# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example  —  Template for production secrets
#
# ⚠️  NEVER commit .env.prod with real values.
#     Copy this file to .env.prod and fill in real values on the server.
#     Add .env.prod to .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=timetable_prod
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_PORT=5432

# ── Spring Boot ───────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://postgres:5432/timetable_prod
DATABASE_USERNAME=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

SPRING_PROFILES_ACTIVE=prod

# ── Java / Timefold ───────────────────────────────────────────────────────────
JAVA_OPTS=
TIMEFOLD_TERMINATION_LIMIT=6m

# ── Ports exposed to host ─────────────────────────────────────────────────────
NGINX_PORT=80
